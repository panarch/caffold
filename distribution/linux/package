#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
DIST_DIR="${REPO_DIR}/target/caffold-linux"
CARGO_TARGET="${CARGO_TARGET_DIR:-${REPO_DIR}/target}"
# The release builds in a manylinux_2_28 container, so its binaries ask for
# nothing newer than that image's glibc and libstdc++, and run on every
# distribution that has those or newer.
GLIBC_CEILING="2.28"
GLIBCXX_CEILING="3.4.25"
# Libraries every glibc distribution carries. Anything else must be compiled
# into the binaries.
SYSTEM_LIBRARIES=(
  libc.so.6 libm.so.6 libpthread.so.0 libdl.so.2 librt.so.1
  libgcc_s.so.1 libstdc++.so.6 ld-linux-x86-64.so.2 ld-linux-aarch64.so.1
)
FILES=(caffold caffold-runner)
VERSION="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "${REPO_DIR}/caffold/Cargo.toml" | head -n 1)"
WEB_VERSION="$(sed -n 's/^[[:space:]]*"version": "\([^"]*\)",/\1/p' "${REPO_DIR}/frontend/package.json" | head -n 1)"
ARCH="$(uname -m)"
ARCHIVE_BASENAME="Caffold-${VERSION}-linux-${ARCH}.tar.gz"
ARCHIVE="${DIST_DIR}/${ARCHIVE_BASENAME}"
CHECKSUM="${ARCHIVE}.sha256"

require_linux() {
  if [[ "$(uname -s)" != "Linux" ]]; then
    echo "Caffold Linux packaging requires Linux." >&2
    exit 1
  fi
}

require_supported_architecture() {
  case "${ARCH}" in
    x86_64|aarch64) ;;
    *)
      echo "Caffold Linux releases support x86_64 and aarch64; found ${ARCH}." >&2
      exit 1
      ;;
  esac
}

validate_source_versions() {
  if [[ -z "${VERSION}" ]]; then
    echo "Could not read the Caffold version from caffold/Cargo.toml." >&2
    exit 1
  fi
  if [[ "${WEB_VERSION}" != "${VERSION}" ]]; then
    echo "caffold/Cargo.toml (${VERSION}) and frontend/package.json (${WEB_VERSION}) versions differ." >&2
    exit 1
  fi
}

archive() {
  require_linux
  require_supported_architecture
  validate_source_versions
  (cd "${REPO_DIR}" && cargo build --release --locked)

  local staging
  staging="$(mktemp -d "${TMPDIR:-/tmp}/caffold-linux.XXXXXX")"
  (
    trap 'rm -rf -- "${staging}"' EXIT
    for file in "${FILES[@]}"; do
      install -m 755 "${CARGO_TARGET}/release/${file}" "${staging}/${file}"
    done
    mkdir -p "${DIST_DIR}"
    rm -f -- "${ARCHIVE}" "${CHECKSUM}"
    tar -czf "${ARCHIVE}" --owner=0 --group=0 --numeric-owner -C "${staging}" "${FILES[@]}"
  )
  (cd "${DIST_DIR}" && sha256sum "${ARCHIVE_BASENAME}" >"${CHECKSUM}")
  verify_archive "${ARCHIVE}" "${VERSION}"

  echo "archive:  ${ARCHIVE}"
  echo "checksum: ${CHECKSUM}"
  echo "sha256:   $(awk '{print $1}' "${CHECKSUM}")"
}

verify_archive_command() {
  local archive="${ARCHIVE}"
  local expected_version="${VERSION}"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    archive="$1"
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --expected-version)
        [[ $# -ge 2 ]] || {
          echo "--expected-version requires a value" >&2
          return 2
        }
        expected_version="$2"
        shift 2
        ;;
      *)
        echo "Unknown verify-archive argument: $1" >&2
        return 2
        ;;
    esac
  done
  [[ "${expected_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || {
    echo "Expected version must be a release version such as 0.1.0." >&2
    return 2
  }
  verify_archive "${archive}" "${expected_version}"
}

# The checksum beside the archive matches, the archive holds exactly the two
# binaries for this machine, they ask for no newer glibc or libstdc++ than the
# release supports and for no library outside the system's, and the server
# answers with the expected version and a build ID that names its commit.
verify_archive() {
  local archive="$1"
  local expected_version="$2"
  local extracted
  extracted="$(mktemp -d "${TMPDIR:-/tmp}/caffold-linux-verify.XXXXXX")"
  (
    trap 'rm -rf -- "${extracted}"' EXIT
    (cd "$(dirname -- "${archive}")" && sha256sum -c "$(basename -- "${archive}").sha256" >/dev/null)
    local listed
    listed="$(tar -tzf "${archive}" | LC_ALL=C sort | tr '\n' ' ')"
    [[ "${listed}" == "caffold caffold-runner " ]] || {
      echo "${archive} must hold caffold and caffold-runner only; it holds: ${listed}" >&2
      exit 1
    }
    tar -xzf "${archive}" -C "${extracted}"
    for file in "${FILES[@]}"; do
      verify_binary "${extracted}/${file}"
    done
    verify_serves "${extracted}/caffold" "${expected_version}"
  )
}

verify_binary() {
  local binary="$1"
  [[ -x "${binary}" ]] || {
    echo "${binary} is not executable." >&2
    exit 1
  }
  local machine
  machine="$(readelf -h "${binary}" | sed -n 's/^ *Machine: *//p')"
  case "${ARCH}:${machine}" in
    "x86_64:Advanced Micro Devices X86-64"|"aarch64:AArch64") ;;
    *)
      echo "${binary} is built for ${machine}, not ${ARCH}." >&2
      exit 1
      ;;
  esac
  require_symbol_ceiling "${binary}" GLIBC "${GLIBC_CEILING}"
  require_symbol_ceiling "${binary}" GLIBCXX "${GLIBCXX_CEILING}"
  local library
  while IFS= read -r library; do
    [[ -n "${library}" ]] || continue
    if ! printf '%s\n' "${SYSTEM_LIBRARIES[@]}" | grep -qxF -- "${library}"; then
      echo "${binary} needs ${library}, which is not a system library." >&2
      exit 1
    fi
  done < <(readelf -d "${binary}" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p')
}

# The newest `<prefix>_x.y` version the binary asks for is no newer than
# `ceiling`.
require_symbol_ceiling() {
  local binary="$1"
  local prefix="$2"
  local ceiling="$3"
  local newest
  newest="$(newest_symbol_version "${prefix}" < <(objdump -T "${binary}"))"
  [[ -z "${newest}" ]] && return 0
  if [[ "$(printf '%s\n%s\n' "${ceiling}" "${newest}" | sort -V | tail -n 1)" != "${ceiling}" ]]; then
    echo "${binary} needs ${prefix}_${newest}, newer than ${prefix}_${ceiling}." >&2
    exit 1
  fi
}

# Reads `objdump -T` output and prints the newest `<prefix>_x.y` it names, or
# nothing when it names none, as for the runner, which uses no libstdc++.
newest_symbol_version() {
  local prefix="$1"
  { grep -o "${prefix}_[0-9][0-9.]*" || true; } | sed "s/^${prefix}_//" | sort -uV | tail -n 1
}

verify_serves() {
  local caffold="$1"
  local expected_version="$2"
  local home port server answered=""
  home="$(mktemp -d "${TMPDIR:-/tmp}/caffold-linux-home.XXXXXX")"
  port="$((20000 + RANDOM % 20000))"
  HOME="${home}" "${caffold}" serve --host 127.0.0.1 --port "${port}" \
    --root "${home}" --data-dir "${home}/data" >"${home}/serve.log" 2>&1 &
  server=$!
  for _ in $(seq 1 60); do
    if answered="$(curl -fsS "http://127.0.0.1:${port}/api/health" 2>/dev/null)"; then
      break
    fi
    sleep 0.5
  done
  kill "${server}" 2>/dev/null || true
  wait "${server}" 2>/dev/null || true
  if [[ "${answered}" != *"\"version\":\"${expected_version}\""* ]]; then
    echo "caffold serve did not answer with version ${expected_version}:" >&2
    cat "${home}/serve.log" >&2
    rm -rf -- "${home}"
    exit 1
  fi
  rm -rf -- "${home}"
  local build_id
  build_id="$(sed -n 's/.*"buildId":"\([^"]*\)".*/\1/p' <<<"${answered}")"
  if [[ ! "${build_id}" =~ ^[0-9a-f]{8}(-dirty)?\.[0-9]+$ ]]; then
    echo "caffold serve answered with build ID ${build_id}, which names no commit; Git could not read the checkout." >&2
    exit 1
  fi
}

metadata() {
  require_supported_architecture
  validate_source_versions
  echo "version=${VERSION}"
  echo "arch=${ARCH}"
  echo "archive=${ARCHIVE_BASENAME}"
  echo "checksum=${ARCHIVE_BASENAME}.sha256"
}

usage() {
  cat <<'EOF'
usage: distribution/linux/package {archive|verify-archive|metadata}

Commands:
  archive         build, archive, checksum, and verify caffold and caffold-runner
  verify-archive [archive] [--expected-version <version>]
                  check an archive against its checksum, this machine, the
                  supported glibc and libstdc++, and its server's version
                  and build ID
  metadata        print the release identity as key=value pairs
EOF
}

# Sourced by its tests for the functions above.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  return 0
fi

case "${1:-}" in
  archive)
    archive
    ;;
  verify-archive)
    require_linux
    require_supported_architecture
    validate_source_versions
    shift
    verify_archive_command "$@"
    ;;
  metadata)
    metadata
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
