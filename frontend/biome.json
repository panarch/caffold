{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**/*.ts"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":PACKAGE:",
                ":ALIAS:",
                ":PATH:",
                "!**/*.css.js",
                "!**/component-styles.js"
              ],
              ":BLANK_LINE:",
              ["**/component-styles.js", "**/*.css.js"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  }
}
