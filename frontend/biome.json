{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.css"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedProperties": "off",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":PACKAGE:", ":ALIAS:", ":PATH:", "!**/*.css.js"],
              ":BLANK_LINE:",
              ["**/*.css.js"]
            ]
          }
        }
      }
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noImportantStyles": "error"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  }
}
