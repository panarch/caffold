{
  "name": "caffold",
  "version": "0.19.8",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./*",
    "#components/*": "./components/*",
    "#tasks/*": "./pages/(task-workspace)/tasks/*"
  },
  "scripts": {
    "test:unit": "npm run build:unit-tests && node --test \"tests/unit-build/**/*.test.js\"",
    "build:unit-tests": "rm -rf tests/unit-build && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json --noEmit false --outDir tests/unit-build",
    "test:contract": "node --test \"tests/contracts/*.test.mjs\"",
    "typecheck": "tsc && tsc -p tsconfig.worker.json",
    "lint": "biome check",
    "test:e2e": "playwright test",
    "test:codex-live": "playwright test --config=playwright.live.config.mjs"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.53.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "docx-preview": "0.4.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "lit": "3.3.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
