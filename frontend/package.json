{
  "name": "caffold",
  "version": "0.19.8",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./*",
    "#components/*": "./components/*",
    "#tasks/*": "./pages/(task-workspace)/tasks/*"
  },
  "scripts": {
    "test:unit": "node --test \"*.test.js\" \"action-hints/**/*.test.js\" \"chunked-fetch/**/*.test.js\" \"components/**/*.test.js\" \"keyboard-navigation/**/*.test.js\" \"pages/**/*.test.js\"",
    "test:contract": "node --test \"tests/contracts/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test:e2e": "playwright test",
    "test:codex-live": "playwright test --config=playwright.live.config.mjs"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "1.3.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.53.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "docx-preview": "0.4.1",
    "pdfjs-dist": "6.3.289",
    "pptxgenjs": "4.0.1",
    "typescript": "5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "dependencies": {
    "lit": "3.3.3"
  }
}
