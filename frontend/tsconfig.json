{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "rootDir": ".",
    "sourceMap": true,
    "inlineSources": true,
    "sourceRoot": "/assets/",
    "importHelpers": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "tests", "service-worker.ts"]
}
