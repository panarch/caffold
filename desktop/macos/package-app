#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/../.." && pwd)"
DIST_DIR="${REPO_DIR}/target/caffold-server"
PRODUCT_NAME="Caffold Server"
BUNDLE_IDENTIFIER="io.panarch.caffold.server"
MINIMUM_MACOS_VERSION="14.0"
SWIFT_SOURCES=(
  "${SCRIPT_DIR}/CaffoldServer.swift"
  "${SCRIPT_DIR}/CaffoldServer/Runtime.swift"
  "${SCRIPT_DIR}/CaffoldServer/SystemStatus.swift"
  "${SCRIPT_DIR}/CaffoldServer/UpdateModel.swift"
  "${SCRIPT_DIR}/CaffoldServer/Updater.swift"
)
APP_DIR="${DIST_DIR}/Caffold Server.app"
CONTENTS_DIR="${APP_DIR}/Contents"
MACOS_DIR="${CONTENTS_DIR}/MacOS"
RESOURCES_DIR="${CONTENTS_DIR}/Resources"
ARCH="$(uname -m)"
VERSION="$(sed -n 's/^version = "\([^"]*\)"/\1/p' "${REPO_DIR}/caffold/Cargo.toml" | head -n 1)"
WEB_VERSION="$(sed -n 's/^[[:space:]]*"version": "\([^"]*\)",/\1/p' "${REPO_DIR}/frontend/package.json" | head -n 1)"
# LaunchServices resolves a bundle identifier partly by CFBundleVersion, and one
# machine installs from several branches and worktrees, so this number must never
# decrease between builds. Build time is monotonic across them; commit depth is not.
BUILD_NUMBER="$(date '+%s')"
BUILD_TIMESTAMP="$(date -r "${BUILD_NUMBER}" '+%Y-%m-%d %H:%M:%S %Z')"
BUILD_COMMIT="$(git -C "${REPO_DIR}" rev-parse --short=8 HEAD)"
if [[ -n "$(git -C "${REPO_DIR}" status --porcelain --untracked-files=no)" ]]; then
  BUILD_COMMIT="${BUILD_COMMIT}-dirty"
fi
ARCHIVE_BASENAME="Caffold-Server-${VERSION}-macos-${ARCH}.zip"
ARCHIVE="${DIST_DIR}/${ARCHIVE_BASENAME}"
CHECKSUM="${ARCHIVE}.sha256"

require_macos() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    echo "Caffold Server packaging requires macOS." >&2
    exit 1
  fi
}

require_supported_architecture() {
  if [[ "${ARCH}" != "arm64" ]]; then
    echo "Caffold Server releases currently support macOS arm64 only; found ${ARCH}." >&2
    exit 1
  fi
}

validate_source_versions() {
  if [[ -z "${VERSION}" ]]; then
    echo "Could not read the Caffold version from caffold/Cargo.toml." >&2
    exit 1
  fi
  if [[ "${WEB_VERSION}" != "${VERSION}" ]]; then
    echo "caffold/Cargo.toml (${VERSION}) and frontend/package.json (${WEB_VERSION}) versions differ." >&2
    exit 1
  fi
}

build_release() {
  (cd "${REPO_DIR}" && cargo build --release --locked)
}

prepare_bundle() {
  rm -rf -- "${APP_DIR}"
  mkdir -p "${MACOS_DIR}" "${RESOURCES_DIR}"

  cp "${REPO_DIR}/target/release/caffold" "${RESOURCES_DIR}/caffold"
  chmod 755 "${RESOURCES_DIR}/caffold"

  # Beside the backend, because that is where the backend looks: a Claude Task
  # is a process the runner holds, and a bundle without it can serve Codex
  # Tasks and nothing else.
  cp "${REPO_DIR}/target/release/caffold-claude-runner" \
    "${RESOURCES_DIR}/caffold-claude-runner"
  chmod 755 "${RESOURCES_DIR}/caffold-claude-runner"

  xcrun swiftc \
    -O \
    -warnings-as-errors \
    -module-cache-path "${DIST_DIR}/swift-module-cache" \
    -framework AppKit \
    -o "${MACOS_DIR}/CaffoldServer" \
    "${SWIFT_SOURCES[@]}"

  install_info_plist
  build_icon
  install_readme

  codesign --force --deep --sign - "${APP_DIR}"
}

install_info_plist() {
  cp "${SCRIPT_DIR}/Info.plist" "${CONTENTS_DIR}/Info.plist"
  /usr/libexec/PlistBuddy \
    -c "Set :CFBundleShortVersionString ${VERSION}" \
    -c "Set :CFBundleVersion ${BUILD_NUMBER}" \
    -c "Set :CaffoldBuildCommit ${BUILD_COMMIT}" \
    -c "Set :CaffoldBuildTimestamp ${BUILD_TIMESTAMP}" \
    "${CONTENTS_DIR}/Info.plist"
}

build_icon() {
  local app_icon="${REPO_DIR}/frontend/assets/icons/icon-512.png"
  local menu_icon="${REPO_DIR}/frontend/assets/icons/favicon-32.png"

  sips -s format icns "${app_icon}" --out "${RESOURCES_DIR}/CaffoldServer.icns" >/dev/null
  cp "${menu_icon}" "${RESOURCES_DIR}/CaffoldMenuIcon.png"
}

install_readme() {
  cp "${SCRIPT_DIR}/README.md" "${RESOURCES_DIR}/README.md"
}

package_archive() {
  rm -f -- "${ARCHIVE}" "${CHECKSUM}"
  ditto -c -k --sequesterRsrc --keepParent "${APP_DIR}" "${ARCHIVE}"
  verify_archive "${ARCHIVE}" "${BUILD_TIMESTAMP}"
  write_checksum
}

verify_bundle() {
  local app_dir="${1:-${APP_DIR}}"
  local expected_build_timestamp="${2-${BUILD_TIMESTAMP}}"
  local expected_version="${3:-${VERSION}}"
  local expected_build_number="${4-${BUILD_NUMBER}}"
  local contents_dir="${app_dir}/Contents"
  local macos_dir="${contents_dir}/MacOS"
  local resources_dir="${contents_dir}/Resources"
  local plist="${contents_dir}/Info.plist"

  require_executable "${macos_dir}/CaffoldServer"
  require_executable "${resources_dir}/caffold"
  require_executable "${resources_dir}/caffold-claude-runner"
  require_file "${resources_dir}/CaffoldServer.icns"
  require_file "${resources_dir}/CaffoldMenuIcon.png"
  require_file "${plist}"
  assert_plist_value "${plist}" CFBundleIdentifier "${BUNDLE_IDENTIFIER}"
  assert_plist_value "${plist}" CFBundleShortVersionString "${expected_version}"
  assert_plist_matches "${plist}" CFBundleVersion '^[0-9]{10}$' \
    "a build time in Unix epoch seconds"
  if [[ -n "${expected_build_number}" ]]; then
    assert_plist_value "${plist}" CFBundleVersion "${expected_build_number}"
  fi
  assert_plist_matches "${plist}" CaffoldBuildCommit '^[0-9a-f]{8}(-dirty)?$' \
    "an abbreviated source commit"
  assert_plist_matches "${plist}" CaffoldBuildTimestamp \
    '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} .+$' \
    "a local build date and time in seconds"
  if [[ -n "${expected_build_timestamp}" ]]; then
    assert_plist_value "${plist}" CaffoldBuildTimestamp "${expected_build_timestamp}"
  fi
  assert_plist_value "${plist}" LSMinimumSystemVersion "${MINIMUM_MACOS_VERSION}"
  verify_binary_architecture "${macos_dir}/CaffoldServer"
  verify_binary_architecture "${resources_dir}/caffold"
  verify_binary_architecture "${resources_dir}/caffold-claude-runner"
  verify_portable_dependencies "${macos_dir}/CaffoldServer"
  verify_portable_dependencies "${resources_dir}/caffold"
  verify_portable_dependencies "${resources_dir}/caffold-claude-runner"
  codesign --verify --deep --strict "${app_dir}"
  plutil -lint "${plist}" >/dev/null
}

require_executable() {
  local path="$1"
  if [[ ! -x "${path}" ]]; then
    echo "Expected executable is missing: ${path}" >&2
    return 1
  fi
}

require_file() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo "Expected file is missing: ${path}" >&2
    return 1
  fi
}

assert_plist_value() {
  local plist="$1"
  local key="$2"
  local expected="$3"
  local actual
  actual="$(/usr/libexec/PlistBuddy -c "Print :${key}" "${plist}")"
  if [[ "${actual}" != "${expected}" ]]; then
    echo "${plist} has ${key}=${actual}; expected ${expected}." >&2
    return 1
  fi
}

assert_plist_matches() {
  local plist="$1"
  local key="$2"
  local pattern="$3"
  local expectation="$4"
  local actual
  actual="$(/usr/libexec/PlistBuddy -c "Print :${key}" "${plist}")"
  if [[ ! "${actual}" =~ ${pattern} ]]; then
    echo "${plist} has ${key}=${actual}; expected ${expectation}." >&2
    return 1
  fi
}

verify_binary_architecture() {
  local binary="$1"
  local architectures
  architectures="$(lipo -archs "${binary}")"
  if [[ " ${architectures} " != *" ${ARCH} "* ]]; then
    echo "${binary} does not contain the expected ${ARCH} architecture." >&2
    return 1
  fi
}

verify_portable_dependencies() {
  local binary="$1"
  local dependency

  while IFS= read -r dependency; do
    [[ -n "${dependency}" ]] || continue
    case "${dependency}" in
      /System/Library/*|/usr/lib/*)
        ;;
      *)
        echo "${binary} has a non-system dynamic dependency: ${dependency}" >&2
        return 1
        ;;
    esac
  done < <(otool -L "${binary}" | tail -n +2 | awk '{print $1}')
}

verify_archive() {
  local archive="${1:-${ARCHIVE}}"
  local expected_build_timestamp="${2-}"
  local expected_version="${3:-${VERSION}}"
  local expected_build_number="${4-${BUILD_NUMBER}}"
  local extract_dir
  extract_dir="$(mktemp -d "${TMPDIR:-/tmp}/caffold-release.XXXXXX")"

  (
    trap 'rm -rf -- "${extract_dir}"' EXIT
    ditto -x -k "${archive}" "${extract_dir}"
    verify_bundle \
      "${extract_dir}/${PRODUCT_NAME}.app" \
      "${expected_build_timestamp}" \
      "${expected_version}" \
      "${expected_build_number}"
  )
}

verify_archive_command() {
  local archive="${ARCHIVE}"
  local expected_version="${VERSION}"

  if [[ $# -gt 0 && "$1" != --* ]]; then
    archive="$1"
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --expected-version)
        [[ $# -ge 2 ]] || {
          echo "--expected-version requires a value" >&2
          return 2
        }
        expected_version="$2"
        shift 2
        ;;
      *)
        echo "Unknown verify-archive argument: $1" >&2
        return 2
        ;;
    esac
  done

  [[ "${expected_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z.-]+)?$ ]] || {
    echo "Expected version must be a release version such as 0.1.0." >&2
    return 2
  }
  verify_archive "${archive}" "" "${expected_version}" ""
}

write_checksum() {
  local digest
  digest="$(shasum -a 256 "${ARCHIVE}" | awk '{print $1}')"
  printf '%s  %s\n' "${digest}" "${ARCHIVE_BASENAME}" >"${CHECKSUM}"
}

build() {
  require_macos
  require_supported_architecture
  validate_source_versions
  mkdir -p "${DIST_DIR}"
  build_release
  prepare_bundle
  verify_bundle

  echo "app:     ${APP_DIR}"
  echo "version: ${VERSION} (${BUILD_COMMIT})"
  echo "built:   ${BUILD_TIMESTAMP}"
  echo "arch:    ${ARCH}"
}

archive() {
  build
  package_archive
  echo "archive: ${ARCHIVE}"
  echo "checksum: ${CHECKSUM}"
  echo "sha256:  $(awk '{print $1}' "${CHECKSUM}")"
}

status() {
  if [[ -d "${APP_DIR}" ]]; then
    echo "app:     ${APP_DIR}"
  else
    echo "app:     not built"
  fi

  if [[ -f "${ARCHIVE}" ]]; then
    echo "archive: ${ARCHIVE}"
  else
    echo "archive: not built"
  fi

  if [[ -f "${CHECKSUM}" ]]; then
    echo "checksum: ${CHECKSUM}"
  else
    echo "checksum: not built"
  fi
}

metadata() {
  require_supported_architecture
  validate_source_versions
  echo "version=${VERSION}"
  echo "arch=${ARCH}"
  echo "archive=${ARCHIVE_BASENAME}"
  echo "checksum=${ARCHIVE_BASENAME}.sha256"
}

usage() {
  cat <<'EOF'
usage: desktop/macos/package-app {build|archive|verify-archive|status|metadata}

Commands:
  build           build and verify the release app bundle
  archive         build, archive, re-extract, verify, and checksum the app
  verify-archive [archive] [--expected-version <version>]
                  re-extract and verify an archive against explicit release identity
  status          print the current bundle and archive paths
  metadata        print the release identity as key=value pairs
EOF
}

case "${1:-build}" in
  build)
    build
    ;;
  archive)
    archive
    ;;
  verify-archive)
    require_macos
    require_supported_architecture
    validate_source_versions
    shift
    verify_archive_command "$@"
    ;;
  status)
    status
    ;;
  metadata)
    metadata
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
